<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Utility DLL for unit tests" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Linux">
				<Option output="build/testdll.so" prefix_auto="0" extension_auto="0" />
				<Option working_dir="build" />
				<Option object_output="build/obj/linux" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Wshadow" />
					<Add option="-Wextra" />
					<Add option="-Wall" />
					<Add option="-pthread" />
					<Add option="-std=c++17" />
					<Add option="-fPIC" />
					<Add option="-g" />
					<Add option="-fvisibility=hidden" />
					<Add directory=".." />
				</Compiler>
				<Linker>
					<Add option="-pthread" />
					<Add option="-Wl,-no-undefined" />
					<Add library="dl" />
				</Linker>
			</Target>
			<Target title="Windows">
				<Option output="build/testdll.dll" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option working_dir="build" />
				<Option object_output="build/obj/windows" />
				<Option type="3" />
				<Option compiler="gcc" />
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="../wcdllmain.cpp">
			<Option weight="100" />
			<Option target="Linux" />
		</Unit>
		<Unit filename="../windef.h">
			<Option target="Linux" />
		</Unit>
		<Unit filename="../windows.h">
			<Option target="Linux" />
		</Unit>
		<Unit filename="../winnt.h">
			<Option target="Linux" />
		</Unit>
		<Unit filename="maindll.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
