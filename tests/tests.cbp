<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Wincompat unit tests" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Windows">
				<Option output="build/tests" prefix_auto="1" extension_auto="1" />
				<Option object_output="build/obj/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-mthreads" />
					<Add option="-O2" />
					<Add option="-municode" />
				</Compiler>
				<Linker>
					<Add option="-mthreads" />
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Werror" />
			<Add option="-Wshadow" />
			<Add option="-Wextra" />
			<Add option="-Wall" />
			<Add option="-ggdb" />
			<Add option="-std=c++17" />
		</Compiler>
		<Unit filename="find.cpp" />
		<Unit filename="find.h" />
		<Unit filename="globals.h" />
		<Unit filename="main.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
