	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Wincompat unit tests" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Windows">
				<Option output="build/tests" prefix_auto="1" extension_auto="1" />
